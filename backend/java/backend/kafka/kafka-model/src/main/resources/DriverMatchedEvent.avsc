{
  "type": "record",
  "name": "DriverMatchedEvent",
  "namespace": "com.example.kafka.avro.model",
  "fields": [
    {
      "name": "correlationId",
      "type": "string"
    },
    {
      "name": "status",
      // MATCHED, CANCELLED, DELIVERY_COMPLETED
      "type": "string"
    },
    {
      "name": "userId",
      "type": "string"
    },
    {
      "name": "address",
      "type": {
        "type": "record",
        "name": "Address",
        "fields": [
          {
            "name": "street",
            "type": "string"
          },
          {
            "name": "city",
            "type": "string"
          },
          {
            "name": "postalCode",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "driverDetails",
      "type": [
        "null",
        {
          "type": "record",
          "name": "DriverDetails",
          "fields": [
            {
              "name": "driverId",
              "type": "string"
            },
            {
              "name": "lat",
              "type": "double"
            },
            {
              "name": "lon",
              "type": "double"
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "createdAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
